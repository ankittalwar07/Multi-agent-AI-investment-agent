# LLM providers — set the one(s) you intend to use.
#
# FREE OPTIONS (no credit card):
#   * Google Gemini — get key at https://aistudio.google.com/apikey
#   * Groq (Llama 3.3 70B + other open-source) — https://console.groq.com/keys
#     Independent rate limits from Gemini, very fast inference.
GOOGLE_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Paid market data — optional. When unset, the corresponding sub-tool returns
# a structured "stub" ToolResult so agents can still call the interface.
BLOOMBERG_API_KEY=
PITCHBOOK_API_KEY=
CRUNCHBASE_API_KEY=
SIMILARWEB_API_KEY=

# Runtime defaults
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash
MAX_COST_USD=5.00
MAX_PARALLEL_RESEARCHERS=4
RUN_OUTPUT_DIR=data/runs
SEED_FILE=data/seeds/ai_infra_components.yaml
